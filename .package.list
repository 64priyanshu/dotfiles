(a) - aur
(*) - has own config

# 1. bash/
[Module]          [Packages]
.bashrc           bash

# 2. bin/
[Module]          [Packages]
batterynotif      dunst(*) libnotify
cboomer-launch    cboomer(https://github.com/laserattack/cboomer)
colorpicker       dunst(*) xcolor xclip imagemagick libnotify
fzf-custom        fzf git(*)
input-switch       rofi(*) libnotify pipewire pipewire-pulse
mediacontrol      dunst(*) libnotify playerctl brightnessctl pipewire pipewire-audio pipewire-pulse pipewire-alsa wireplumber pipewire-jack pavucontrol
notif-sound       dunst(*)
pacman-list
recorder          ffmpeg slop i3blocks(*)
system            rofi(*)
webcam            mpv(*) cameractrls

# 3. dunst/
[Module]          [Packages]
dunstrc           dunst rofi(*) firefox ttf-twemoji(a) getnf(https://github.com/getnf/getnf)

# 4. font/
[Module]          [Packages]
fonts.conf        noto-fonts

# 5. git/
[Module]          [Packages]
.gitconfig        git github-cli

# 6. i3/
[Module]          [Packages]
config            i3-wm i3lock xss-lock kitty(*) firefox yazi rofi(*) rofi-emoji rofi-greenclip(a) flameshot getnf(https://github.com/getnf/getnf) cboomer(https://github.com/laserattack/cboomer) ripdrag(a)
i3blocks.conf     i3blocks

