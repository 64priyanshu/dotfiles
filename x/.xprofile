# For QT Themes
export QT_QPA_PLATFORMTHEME=qt5ct

# Environment variables set everywhere
export EDITOR="nvim"
export TERMINAL="kitty"
export BROWSER="firefox"

# Touchpad/Mouse - xinput list
export TOUCHPAD=$(xinput list --name-only | grep -i touchpad)
# Trackpad speed (-1 to 1)
xinput set-prop "$TOUCHPAD" "libinput Accel Speed" 0

# Force Mozilla to bypass legacy touchpad emoulation
export MOZ_USE_XINPUT2=1
# Check gestures with libinput-tools (libinput {debug-events, debug-gui})

# Remap caps to escape
# setxkbmap -option caps:escape
# Swap escape and caps
# setxkbmap -option caps:swapescape

# Keys speed
xset r rate 550 25 # initial delay 600ms, repeat 25 ms

# Enable DPMS (Display Power Management Signaling)
xset +dpms

# Turn off screensaver
xset s off

# Suspend after 10 minutes of inactivity (only if no media is playing)
# Requires mpv-mpris for playerctl to recognize mpv
# xautolock -time 10 -locker 'playerctl -a status 2>/dev/null | grep -q "^Playing$" || systemctl suspend' -detectsleep &

# Checks pipewire sinks (doesn't need playerctl and mpv-mpris)
# xautolock -time 10 -locker 'pactl list sinks short 2>/dev/null | awk "{print \$NF}" | grep -qx RUNNING || systemctl suspend' -detectsleep &

# Check pipewire sink and check if app is fullscreen
# xautolock -time 10 -locker 'pactl list sinks short 2>/dev/null | awk "{print \$NF}" | grep -qx RUNNING || xprop -id "$(xdotool getactivewindow 2>/dev/null)" _NET_WM_STATE 2>/dev/null | grep -q FULLSCREEN || systemctl suspend' -detectsleep &

# Check if battery is full, pipewire sink and if app is fullscreen
# xautolock -time 10 -locker 'grep -qxE "Charging|Full" /sys/class/power_supply/BAT*/status 2>/dev/null || pactl list sinks short 2>/dev/null | awk "{print \$NF}" | grep -qx RUNNING || xprop -id "$(xdotool getactivewindow 2>/dev/null)" _NET_WM_STATE 2>/dev/null | grep -q FULLSCREEN || systemctl suspend' -detectsleep &

# Shorter final version
xautolock -time 10 -locker 'grep -qxE "Charging|Full" /sys/class/power_supply/BAT*/status || pactl list sinks short | grep -q "\sRUNNING$" || xprop -id "$(xdotool getactivewindow)" _NET_WM_STATE | grep -q FULLSCREEN || systemctl suspend' -detectsleep &

# Suspend after closing Laptop's Lid
# sudoedit /etc/systemd/logind.conf and uncomment #HandleLidSwitch=suspend

# Screen Wallpaper: sudo pacman -S feh
# feh --bg-fill $XDG_PICTURES_DIR/wallpapers/wallpaper.png &
feh --randomize --bg-fill $XDG_PICTURES_DIR/wallpapers/* &

# Network Manager Applet
nm-applet --indicator &

# Screenshots
flameshot &

# Notifications
dunst &

# Clipboard manager: https://github.com/erebe/greenclip
greenclip daemon &

# Compositor
picom -b

redshift &
