#!/bin/sh

# https://github.com/laserattack/cboomer
# Clone the repo somewhere, and ln -s full/path/cboomer ~/.local/bin

# Modify values in cboomer/src/config.h
# Config default_config = {
# 	.feather = 0.025f,
#
# 	.screenshot_path = "~/Pictures/screenshots/cboomer_screenshot.png",
#
# 	.texture_filter = 1,
#
# 	.key_escape = XK_q,
# 	.key_flashlight = XK_2,
# 	.key_reset = XK_1,
# 	.key_zoom_in = XK_equal,
# 	.key_zoom_out = XK_minus,
# 	.key_rotate_left = XK_9,
# 	.key_rotate_right = XK_0,
# 	.key_mirror = XK_3,
# 	.key_save_screenshot = XK_s,
# };

# Prevent multiple Magnifier instances
if pgrep -fx "$HOME/.local/bin/cboomer" >/dev/null; then
	exit 0
fi

# Change cursor to indicate cboomer is active
xsetroot -cursor_name center_ptr

# Execute Magnifier cboomer
"$HOME/.local/bin/cboomer" &

# Get PID of cboomer
pid=$!

# Tell i3blocks that cboomer started
pkill -RTMIN+6 i3blocks

# Wait until cboomer exits
wait "$pid"

# Restore default pointer cursor
xsetroot -cursor_name left_ptr

# Tell i3blocks that cboomer stopped
pkill -RTMIN+6 i3blocks
